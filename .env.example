# Required: API token from https://app.adaptlypost.com/api-tokens
ADAPTLYPOST_API_TOKEN=adaptly_your-api-token-here

# Also accepted, checked after ADAPTLYPOST_API_TOKEN
# ADAPTLYPOST_API_KEY=adaptly_your-api-token-here

# Optional: Custom API base URL (defaults to production)
# ADAPTLYPOST_API_URL=https://post.adaptlypost.com/post/api/v1

# Optional: credential profile to use instead of the one marked current
# ADAPTLYPOST_PROFILE=default

# Optional: log every request, redacted, to stderr
# ADAPTLYPOST_DEBUG=1

# Optional: force machine mode (JSON on stdout) even on a TTY
# ADAPTLYPOST_JSON=1

# Optional: strip ANSI colour from all output
# NO_COLOR=1
